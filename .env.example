# Copiá este archivo como ".env" (en la misma carpeta) y completá con los datos
# de tu servicio MySQL en Aiven (pestaña "Overview" > "Connection information").
# Aiven exige SSL: dejá el ?sslMode=REQUIRED al final de la URL.
DB_URL=jdbc:mysql://HOST:PUERTO/defaultdb?sslMode=REQUIRED
DB_USER=avnadmin
DB_PASSWORD=tu_password_de_aiven
